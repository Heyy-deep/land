# ==============================================================================
# NATIONAL LAND ACQUISITION MONITORING SYSTEM (NLAMS) - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local development, or set these keys in Render Dashboard.
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Server & Runtime Configuration
ENVIRONMENT=production
NODE_ENV=production
PORT=8000
BACKEND_HOST=0.0.0.0

# Database Configuration (Render Managed PostgreSQL with PostGIS)
# For local development: postgresql://nlams_user:nlams_password@localhost:5432/nlams_db
# In Render: Automatically provided by Render as DATABASE_URL
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Security & Authentication
# Generate a secure 256-bit key via: openssl rand -hex 32
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g., https://nlams-frontend.vercel.app,http://localhost:3000)
# Set to * to allow all origins during initial deployment
CORS_ORIGINS=*

# OTP & Notification Service Keys (Optional - in-memory fallback enabled by default)
SMS_GATEWAY_API_KEY=
EMAIL_SERVICE_API_KEY=
